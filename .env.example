# BolBindass needs NO environment variables. Everything below is optional.
# Copy to .env.local only if you want to change something. Never commit real keys.

# Local Ollama server. Only loopback addresses (127.0.0.1 / localhost / ::1)
# are accepted; anything else is blocked so no request can leave this PC.
# BOLBINDASS_OLLAMA_URL=http://127.0.0.1:11434

# Default local model when none is chosen in Settings.
# BOLBINDASS_OLLAMA_MODEL=llama3.2:3b

# Sarvam AI is NOT used. If a key is set here, the app only reports that a key
# exists (Settings → Optional paid services) and never calls Sarvam.
# SARVAM_API_KEY=
